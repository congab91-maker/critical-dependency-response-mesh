# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly pin LF for contract, python, and frontend source files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
